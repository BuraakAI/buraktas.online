---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft && data.lang === "en")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Base
  lang="en"
  title="Notes — Burak Taş"
  description="Notes by Burak Taş on AI, autonomous systems and agricultural technology."
>
  <nav class="topnav">
    <a class="topnav-logo" href="/en">
      <img src="/assets/favicon.jpg" alt="Burak Taş" /> Burak Taş
    </a>
  </nav>

  <main class="blog-wrap">
    <header class="blog-head">
      <span class="eyebrow">Blog</span>
      <h1 class="section-title serif">Notes</h1>
      <p class="section-intro">
        Writing, experiments and ship logs on AI, autonomous systems and agricultural technology.
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="post-desc">The first note is coming soon.</p>
      ) : (
        <ul class="post-list">
          {posts.map((p) => (
            <li class="post-item">
              <a href={`/en/blog/${p.slug}`}>
                <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
                <span class="post-title serif">{p.data.title}</span>
                <span class="post-desc">{p.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Base>
