        </div>
        <div class="skillgroup rv">
          <h3>Electronics</h3>
          <div class="tags"><span class="tag">ESP32 / Arduino</span><span class="tag">Sensor Integration</span><span class="tag">PCB Design</span><span class="tag">IoT Protocols</span></div>
        </div>
