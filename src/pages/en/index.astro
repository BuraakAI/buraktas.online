    <div class="container">
      <div class="section-head rv">
        <span class="eyebrow">Expertise</span>
        <h2 class="section-title serif">Technical Skills</h2>
        <p class="section-intro">Three axes that carry a product from scratch to the field: software, mechanics, electronics.</p>
      </div>
      <div class="skills">
        <div class="skillgroup rv">
          <h3>Software / AI</h3>
          <div class="tags"><span class="tag">Python</span><span class="tag">OpenCV</span><span class="tag">TensorFlow Lite</span><span class="tag">C/C++ (ESP32)</span><span class="tag">Git</span></div>
        </div>
        <div class="skillgroup rv">
