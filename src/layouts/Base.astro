---
import "../styles/global.css";
interface Props { title: string; description?: string; image?: string; lang?: "tr" | "en"; redirect?: boolean; }
const {
  title,
  description = "AI ile işleri ustalığa taşıyorum.",
  image = "/assets/og.jpg",
  lang = "tr",
  redirect = false,
} = Astro.props;
const isEN = lang === "en";
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://buraktas.online");
// Uluslararası ziyaretçiyi /en'e yönlendir — kullanıcının açık dil tercihine (localStorage) saygı duyarak
const redirectJS =
  "(function(){try{var s=localStorage.getItem('site-lang');if(s==='en'){location.replace('/en'+location.search+location.hash);return;}if(s==='tr'){return;}var L=navigator.languages||[navigator.language||''];var tr=L.some(function(l){return (l||'').toLowerCase().indexOf('tr')===0;});if(!tr){location.replace('/en'+location.search+location.hash);}}catch(e){}})();";
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {redirect && <script is:inline set:html={redirectJS} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F3EDE1" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/jpeg" href="/assets/favicon.jpg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonical)} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <link rel="alternate" type="application/rss+xml" title="Burak Taş — Notlar" href="/rss.xml" />
  </head>
  <body>
    <nav class="langswitch" aria-label="language">
      <a href="/" data-lang="tr" class={isEN ? "" : "on"}>TR</a><span>/</span><a href="/en" data-lang="en" class={isEN ? "on" : ""}>EN</a>
    </nav>
    <slot />
    <footer>🐇 Burak Taş · {isEN ? "fast & precise" : "hız & itina"} · 2026 · buraktas.online</footer>
    <div id="toast" class="toast" role="status" aria-live="polite"></div>
    <script is:inline>
      document.documentElement.classList.add("js");
      const io = new IntersectionObserver(
        (es) => { for (const e of es) { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } } },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
      );
      document.querySelectorAll(".rv").forEach((el) => io.observe(el));
      function toast(msg) {
        const t = document.getElementById("toast");
        if (!t) return;
        t.textContent = msg; t.classList.add("show");
        clearTimeout(t._h); t._h = setTimeout(() => t.classList.remove("show"), 2800);
      }
      document.querySelectorAll(".js-mail").forEach((a) => {
        a.addEventListener("click", () => {
          const em = "buraktasbiosystem@gmail.com";
          try { if (navigator.clipboard) navigator.clipboard.writeText(em); } catch (e) {}
          toast("E-posta panoya kopyalandı ✓  " + em);
        });
      });
      document.querySelectorAll(".langswitch a[data-lang]").forEach((a) => {
        a.addEventListener("click", () => {
          try { localStorage.setItem("site-lang", a.getAttribute("data-lang")); } catch (e) {}
        });
      });
    </script>
  </body>
</html>
